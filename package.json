{
  "name": "onepalace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/user",
    "apps/admin",
    "apps/master",
    "engine"
  ],
  "scripts": {
    "dev": "node scripts/boot.js",
    "dev:engine": "npm run dev --workspace @cortex/engine",
    "dev:user": "npm run dev --workspace @cortex/user",
    "dev:admin": "npm run dev --workspace @cortex/admin",
    "dev:master": "npm run dev --workspace @cortex/master",
    "build": "npm run build --workspace @cortex/user && npm run build --workspace @cortex/admin && npm run build --workspace @cortex/master",
    "build:user": "npm run build --workspace @cortex/user",
    "build:admin": "npm run build --workspace @cortex/admin",
    "build:master": "npm run build --workspace @cortex/master",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace @cortex/user && npm run typecheck --workspace @cortex/admin && npm run typecheck --workspace @cortex/master"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "concurrently": "^9.0.1"
  }
}
